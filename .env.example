# Server-only Fastify origin. Never put MongoDB credentials in the frontend.
BACKEND_API_URL=http://127.0.0.1:4000
# Meta Ads server-only configuration. Generate a 32-byte hex key; never expose it to the browser.
META_ADS_OAUTH_SCOPES=ads_read,ads_management,business_management,catalog_management
META_TOKEN_ENCRYPTION_KEY=
# Onboarding proxy operations are intentionally blocked in production until auth exists.
