{
  "name": "easy-shop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "npm run check:api-docs && npm run build && npm test",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "test": "npm run build && node test/database-failure.mjs && node test/local-mongo.mjs",
    "db:indexes": "npm run build && node scripts/ensure-indexes.mjs",
    "test:atlas": "npm run build && node test/onboarding.integration.mjs",
    "test:inventory": "npm run build && node test/inventory.integration.mjs",
    "test:customers": "npm run build && node test/customers.integration.mjs",
    "test:inbox": "npm run build && node test/ai-replies.integration.mjs",
    "test:ai-provider": "npm run build && node test/openai-provider.test.mjs",
    "test:auth": "npm run build && node test/auth.integration.mjs",
    "test:storefront-chat": "npm run build && node test/storefront-messaging.integration.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0",
    "mongodb": "^7.7.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.6.0"
  }
}
